# ── OmClaw Environment Config ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b

# GitHub Integration (optional — needed for Phase 4)
GITHUB_PAT=your_github_personal_access_token_here

# Docker Sandbox
DOCKER_SANDBOX_IMAGE=omclaw-sandbox:latest
DOCKER_WORKSPACE_DIR=/workspace
HOST_WORKSPACE_DIR=./workspace

# Database
DATABASE_URL=sqlite+aiosqlite:///./omclaw.db

# Memory / Retrieval
VECTOR_STORE=faiss           # faiss or chroma
EMBEDDING_MODEL=nomic-embed-text  # Ollama embedding model

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Logging
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
