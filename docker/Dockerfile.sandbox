# OmClaw Execution Sandbox
# All agent-generated code runs inside this container — never on the host.

FROM python:3.12-slim

# System tools available to the agent
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    wget \
    bash \
    build-essential \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

# Working directory that gets mounted from host
WORKDIR /workspace

# Non-root user for safety
RUN useradd -m -u 1001 sandbox
USER sandbox

CMD ["/bin/bash"]
